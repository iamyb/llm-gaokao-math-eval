# 复制为 .env 并按需修改
# Copy this file to .env and fill in your own values

# 题目提取 API 地址（OpenAI 兼容接口，如 llama.cpp server / vLLM / Ollama 等）
# Question extraction API endpoint (OpenAI-compatible, e.g. llama.cpp server / vLLM / Ollama)
EXTRACT_API_URL=http://192.168.0.41:9292

# API Key（本地部署通常可随意填写，如 "none"）
# API key (for local deployments this is usually a placeholder like "none")
EXTRACT_API_KEY=none

# 用于提取题目的视觉模型名称
# Vision model name used for question extraction
EXTRACT_MODEL=Qwen3.5-9B-UD-Q6_K_XL-MTP

# ---- 评测相关 ----
# Evaluation server (llama.cpp / vLLM serving the model to evaluate)
EVAL_SERVER=http://192.168.0.41:9292

# If models in one YAML use different providers, put their key names in YAML
# with api_key_env and define the actual keys here instead.
# PROVIDER_A_API_KEY=your-provider-a-key
# PROVIDER_B_API_KEY=your-provider-b-key

# LLM grader server and model
EVAL_GRADER_SERVER=http://localhost:10001
EVAL_GRADER_MODEL=qwen3.6-35b-a3b
